<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves that the loader's .NET Framework build computes what its .NET 10 build does for the values
    Rock checks: the key derivations behind check scanner fields and note mentions, Rock's keyed hash,
    package checksums, and seeded random draws. Run it once for each target (see the loader README).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <RootNamespace>RockSampleData.LoaderCompatCheck</RootNamespace>
    <AssemblyName>rock-sample-data-compat-check</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\loader\RockSampleData.Loader.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
