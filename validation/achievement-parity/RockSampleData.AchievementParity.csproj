<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs Rock's own streak and achievement code against a loaded sample database. It builds against a Rock
    checkout's integration test output, which holds Rock.dll and everything it needs:
      dotnet build -p:RockBin="C:\Development\Rock\Rock.Tests.Integration\bin\Debug\net472"
    It is not part of rock-sample-data.sln, because it needs Rock and the .NET Framework.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RockSampleData.AchievementParity</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <FrameworkPathOverride Condition="Exists('$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2')">$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2</FrameworkPathOverride>
  </PropertyGroup>

  <Target Name="RequireRockBin" BeforeTargets="ResolveAssemblyReferences" Condition="'$(RockBin)' == ''">
    <Error Text="Pass -p:RockBin=&lt;Rock checkout&gt;\Rock.Tests.Integration\bin\Debug\net472 (build Rock.Tests.Integration first)." />
  </Target>

  <ItemGroup Condition="'$(RockBin)' != ''">
    <Reference Include="$(RockBin)\*.dll" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Web" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>

</Project>
