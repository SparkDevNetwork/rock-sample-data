# Store text with LF line endings in the repository, whatever each person's git settings are.
* text=auto

# Binary files: never convert line endings or show text diffs.
*.jpg binary
*.jpeg binary
*.png binary
*.ttf binary
*.xlsx binary

# Git hooks are shell scripts, which fail with Windows line endings.
.githooks/* text eol=lf

# Written by the verify tool. On a merge conflict, take either side and re-record it (AGENTS.md).
validation/rock-contract.json linguist-generated=true
